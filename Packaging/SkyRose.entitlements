<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: Apple Events to System Events / Spotify / Music (session menu, media card). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Microphone for the optional "record with sound". -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Location, only when Settings › Bar and Shell › Weather › "Use my location" is on (off by default). -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
