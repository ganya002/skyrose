<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registered by the app through SMAppService.agent(plistName:) with the user's consent.
	     KeepAlive relaunches the WM after a crash; on relaunch it restores parked windows from
	     the journal before doing anything else (spec 10.10). Runs as the user, never as root. -->
	<key>Label</key>
	<string>com.caelestia.mac.wm</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/CaelestiaWM</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CAELESTIA_LAUNCHD</key>
		<string>1</string>
	</dict>
</dict>
</plist>
