<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.skyrose.sa-loader</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Library/Application Support/SkyRose/skyrose-sa-daemon.sh</string>
